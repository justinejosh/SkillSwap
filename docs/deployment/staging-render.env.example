# Dedicated Render service ONLY: knoxite-backend-staging / dev-justine.
# Deliberately incomplete; no hosted service or approval is activated here.
NODE_VERSION=22
NODE_ENV=production
HOST=0.0.0.0
# PORT is supplied by Render.
DATABASE_URL=
# mysql://knoxite_staging_app:<ENCODED_PRIVATE_PASSWORD>@<RAILWAY_PUBLIC_PROXY_HOST>:<PROXY_PORT>/<ACTUAL_SCHEMA>?sslcert=%2Fetc%2Fsecrets%2Frailway-mysql-ca.pem&sslaccept=strict
# Upload the independently verified CA as a private Render Secret File first.
JWT_SECRET=
PUBLIC_APP_URL=https://REPLACE-WITH-ACTUAL-STAGING-FRONTEND.vercel.app
CORS_ORIGINS=https://REPLACE-WITH-ACTUAL-STAGING-FRONTEND.vercel.app
INSTITUTION_EMAIL_DOMAINS=student.fatima.edu.ph
CAMPUS_EMAIL_SUFFIX=lag
EMAIL_VERIFICATION_REQUIRED=true
CAMPUS_EMAIL_RULE_CONFIRMED=false
SESSION_TIMEOUTS_ENABLED=true
REGISTRATION_CONSENT_ENABLED=false
REGISTRATION_NOTICE_VERSION=
REGISTRATION_NOTICE_APPROVED=false
# True requires actual recorded campus/notice decisions, not placeholders.
# Production-shaped startup intentionally refuses the current incomplete values.
GOOGLE_SIGN_IN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_HOSTED_DOMAINS=
GOOGLE_WORKSPACE_ACCESS_CONFIRMED=false
GOOGLE_ELIGIBILITY_RULES_CONFIRMED=false
GOOGLE_SECURITY_REVIEW_CONFIRMED=false
GOOGLE_ELIGIBILITY_POLICY_VERSION=
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_SENDER_APPROVED=false
# Do not copy local OAuth/synthetic variables, migrator/root passwords, or any
# existing production environment group. No webhook fallback credentials needed.
