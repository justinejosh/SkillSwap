{
  "name": "knoxite-backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "npm run db:ensure",
    "dev": "node --watch --require ts-node/register index.ts",
    "prebuild": "npm run db:ensure",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "pretypecheck": "npm run db:ensure",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 dist/tests/*.test.js",
    "test:integration": "npm run build && node development/ciIntegration.cjs",
    "db:generate": "prisma generate",
    "db:ensure": "node scripts/ensure-prisma-client.cjs",
    "db:preflight": "ts-node --prefer-ts-exts scripts/preflight.ts",
    "db:backfill": "ts-node --prefer-ts-exts scripts/backfill.ts",
    "db:bootstrap": "ts-node --prefer-ts-exts scripts/migrate-local.ts bootstrap",
    "db:upgrade": "ts-node --prefer-ts-exts scripts/migrate-local.ts upgrade",
    "db:upgrade:google": "ts-node --prefer-ts-exts scripts/migrate-google.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1175.0",
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "google-auth-library": "^11.3.3",
    "jsonwebtoken": "^9.0.3",
    "multer": "2.5.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "2.3.0",
    "@types/node": "^25.5.2",
    "prisma": "^6.19.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "@prisma/config": {
      "effect": "3.22.1"
    }
  }
}
