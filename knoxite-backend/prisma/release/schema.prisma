// Release schema: fresh installs only; shared legacy client remains intentional.


enum AssessmentTier {
  NOT_ASSESSED
  AMATEUR
  VERIFIED
}

enum AssessmentLevel {
  BASIC
  ADVANCED
}

enum AssessmentVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum AssessmentAttemptStatus {
  IN_PROGRESS
  PASSED
  FAILED
  EXPIRED
}

model Department {
  id       String    @id @default(uuid())
  code     String    @unique
  name     String
  isActive Boolean   @default(true)
  programs Program[]
}

model YearLevel {
  programs Program[] @relation("ProgramYearLevels")
  id       String    @id @default(uuid())
  code     String    @unique
  name     String
  order    Int
  isActive Boolean   @default(true)
  users    User[]
}

model UserOfferedSkill {
  id                        String              @id @default(uuid())
  userId                    String
  skillId                   String
  isActive                  Boolean             @default(true)
  tier                      AssessmentTier      @default(NOT_ASSESSED)
  tierAwardedAt             DateTime?
  awardAttemptId            String?             @unique
  awardAttempt              AssessmentAttempt?  @relation("TierAward", fields: [awardAttemptId], references: [id], onDelete: Restrict)
  basicPromptDismissedAt    DateTime?
  advancedPromptDismissedAt DateTime?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  user                      User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  skill                     Skill               @relation(fields: [skillId], references: [id], onDelete: Restrict)
  attempts                  AssessmentAttempt[] @relation("OfferingAttempts")

  @@unique([userId, skillId])
  @@index([skillId, isActive])
}

model AssessmentBank {
  id       String              @id @default(uuid())
  skillId  String
  level    AssessmentLevel
  title    String
  skill    Skill               @relation(fields: [skillId], references: [id], onDelete: Restrict)
  versions AssessmentVersion[]

  @@unique([skillId, level])
}

model AssessmentVersion {
  id               String                  @id @default(uuid())
  bankId           String
  version          Int
  status           AssessmentVersionStatus @default(DRAFT)
  questionCount    Int                     @default(10)
  passingPercent   Int                     @default(80)
  durationMinutes  Int                     @default(20)
  maxStarts        Int                     @default(3)
  windowHours      Int                     @default(168)
  cooldownHours    Int                     @default(24)
  learningOutcomes String                  @db.Text
  validationNotes  String?                 @db.Text
  validatedById    String?
  validatedAt      DateTime?
  publishedAt      DateTime?
  createdById      String
  createdAt        DateTime                @default(now())
  bank             AssessmentBank          @relation(fields: [bankId], references: [id], onDelete: Restrict)
  items            AssessmentItem[]
  attempts         AssessmentAttempt[]

  @@unique([bankId, version])
  @@index([bankId, status])
}

model AssessmentItem {
  id           String                  @id @default(uuid())
  versionId    String
  kind         String                  @default("MULTIPLE_CHOICE")
  prompt       String                  @db.Text
  competency   String
  rubric       String                  @db.Text
  points       Int                     @default(1)
  version      AssessmentVersion       @relation(fields: [versionId], references: [id], onDelete: Restrict)
  options      AssessmentOption[]
  attemptItems AssessmentAttemptItem[]
}

model AssessmentOption {
  id        String         @id @default(uuid())
  itemId    String
  text      String         @db.Text
  isCorrect Boolean
  item      AssessmentItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
}

model AssessmentAttempt {
  id             String                  @id @default(uuid())
  offeringId     String
  versionId      String
  level          AssessmentLevel
  attemptNumber  Int
  status         AssessmentAttemptStatus @default(IN_PROGRESS)
  passingPercent Int
  policy         Json
  startedAt      DateTime                @default(now())
  expiresAt      DateTime
  submittedAt    DateTime?
  gradedAt       DateTime?
  earnedPoints   Int?
  possiblePoints Int?
  offering       UserOfferedSkill        @relation("OfferingAttempts", fields: [offeringId], references: [id], onDelete: Restrict)
  awardFor       UserOfferedSkill?       @relation("TierAward")
  version        AssessmentVersion       @relation(fields: [versionId], references: [id], onDelete: Restrict)
  items          AssessmentAttemptItem[]

  @@unique([offeringId, level, attemptNumber])
  @@index([offeringId, level, startedAt])
}

model AssessmentAttemptItem {
  id             String            @id @default(uuid())
  attemptId      String
  itemId         String
  position       Int
  optionOrder    Json
  answerOptionId String?
  awardedPoints  Int?
  attempt        AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  item           AssessmentItem    @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([attemptId, itemId])
  @@unique([attemptId, position])
}

model SessionConfirmation {
  id            String   @id @default(uuid())
  swapId        String
  participantId String
  sessionNumber Int
  confirmedAt   DateTime @default(now())
  actualCompletedAt DateTime?
  swap          Swap     @relation(fields: [swapId], references: [id], onDelete: Restrict)

  @@unique([swapId, participantId, sessionNumber])
}

model AuthSession {
  lastInteractiveAt DateTime?
  id        String    @id @default(uuid())
  userId    String
  userAgent String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model ExternalIdentity {
  id             String   @id @default(uuid())
  provider       String   @db.VarChar(16)
  subject        String   @db.VarChar(255)
  userId         String
  verifiedEmail  String   @db.VarChar(191)
  hostedDomain   String   @db.VarChar(191)
  policyVersion  String   @db.VarChar(191)
  linkedAt       DateTime @default(now())
  lastVerifiedAt DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, subject])
  @@unique([userId, provider])
}

model GoogleAuthChallenge {
  id               String    @id @default(uuid())
  purpose          String    @db.VarChar(16)
  nonceHash        String    @db.Char(64)
  browserProofHash String    @db.Char(64)
  policyVersion    String    @db.VarChar(191)
  userId           String?
  sessionId        String?
  tokenVersion     Int?
  subject          String?   @db.VarChar(255)
  verifiedEmail    String?   @db.VarChar(191)
  hostedDomain     String?   @db.VarChar(191)
  displayName      String?   @db.VarChar(100)
  expiresAt        DateTime
  usedAt           DateTime?
  createdAt        DateTime  @default(now())

  @@index([expiresAt])
}

model UserReport {
  id           String    @id @default(uuid())
  reporterId   String
  targetId     String
  reason       String
  description  String    @db.Text
  status       String    @default("PENDING")
  resolution   String?   @db.Text
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  reporter     User      @relation("ReportAuthor", fields: [reporterId], references: [id], onDelete: Restrict)
  target       User      @relation("ReportTarget", fields: [targetId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  evidence     ReportEvidence?

}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------
// 1. USER MODEL
// -------------------------------------------------
model User {
  registrationConsents RegistrationConsent[]
  programId       String?
  program         Program?  @relation(fields: [programId], references: [id], onDelete: Restrict)
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  passwordHash    String?
  bio             String?   @db.Text
  gender          String?
  avatarUrl       String?   @db.MediumText
  location        String?
  role            Role      @default(USER)
  isSuspended     Boolean   @default(false)
  emailVerifiedAt DateTime?
  tokenVersion    Int       @default(0)

  yearLevelId String?

  yearLevel          YearLevel?               @relation(fields: [yearLevelId], references: [id], onDelete: Restrict)
  offeringLinks      UserOfferedSkill[]
  authSessions       AuthSession[]
  verificationTokens EmailVerificationToken[]
  externalIdentities ExternalIdentity[]
  reportsFiled       UserReport[]             @relation("ReportAuthor")
  reportsReceived    UserReport[]             @relation("ReportTarget")
  posts              Post[]                   @relation("UserPosts")
  comments           Comment[]                @relation("UserComments")
  createdAt          DateTime                 @default(now())

  // Legacy implicit skill relations are retained during the additive rollout.

  offeredSkills Skill[] @relation("OfferedSkills")
  wantedSkills  Skill[] @relation("WantedSkills")

  requestsSent     SwapRequest[] @relation("Requester")
  requestsReceived SwapRequest[] @relation("Receiver")

  swapsRequested Swap[] @relation("RequestedSwaps")
  swapsReceived  Swap[] @relation("ReceivedSwaps")

  reviewsGiven    Review[] @relation("Reviewer")
  reviewsReceived Review[] @relation("Reviewee")

  messagesSent     Message[] @relation("Sender")
  messagesReceived Message[] @relation("Receiver")

  boardPosts BoardPost[] @relation("UserBoardPosts")
}

// -------------------------------------------------
// 2. SKILL MODEL
// -------------------------------------------------
model Skill {
  id       String @id @default(uuid())
  name     String @unique
  category String

  offeredBy       User[]             @relation("OfferedSkills")
  wantedBy        User[]             @relation("WantedSkills")
  offeringLinks   UserOfferedSkill[]
  assessmentBanks AssessmentBank[]

  swapsOffered SwapRequest[] @relation("SwapOfferedSkill")
  swapsWanted  SwapRequest[] @relation("SwapWantedSkill")

  activeOffered Swap[] @relation("ActiveOfferedSkill")
  activeWanted  Swap[] @relation("ActiveWantedSkill")
}

// -------------------------------------------------
// 3. SWAP REQUEST MODEL (Marketplace/Board Requests)
// -------------------------------------------------
model SwapRequest {
  message        String?           @db.Text
  id             String            @id @default(uuid())
  status         SwapRequestStatus @default(PENDING)
  linkedSwap     Swap?
  scheduledDate  DateTime?
  meetingLink    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  requesterId    String
  receiverId     String
  offeredSkillId String
  wantedSkillId  String

  requester    User  @relation("Requester", fields: [requesterId], references: [id])
  receiver     User  @relation("Receiver", fields: [receiverId], references: [id])
  offeredSkill Skill @relation("SwapOfferedSkill", fields: [offeredSkillId], references: [id])
  wantedSkill  Skill @relation("SwapWantedSkill", fields: [wantedSkillId], references: [id])
}

// -------------------------------------------------
// 4. REVIEW MODEL (Updated to link to Swap)
// -------------------------------------------------
model Review {
  id          String   @id @default(uuid())
  rating      Int
  isValidated Boolean  @default(false)
  comment     String?  @db.Text
  createdAt   DateTime @default(now())

  swapId     String
  reviewerId String
  revieweeId String

  swap     Swap @relation(fields: [swapId], references: [id])
  reviewer User @relation("Reviewer", fields: [reviewerId], references: [id])
  reviewee User @relation("Reviewee", fields: [revieweeId], references: [id])

  @@unique([swapId, reviewerId])
  @@index([revieweeId, isValidated])
}

// -------------------------------------------------
// 5. MESSAGE MODEL (Updated to link to Swap)
// -------------------------------------------------
model Message {
  id         String   @id @default(uuid())
  content    String   @db.Text
  createdAt  DateTime @default(now())
  senderId   String
  receiverId String
  swapId     String // Link to the specific Swap instance

  sender   User @relation("Sender", fields: [senderId], references: [id])
  receiver User @relation("Receiver", fields: [receiverId], references: [id])
  swap     Swap @relation(fields: [swapId], references: [id]) // Establishing relation
}

// -------------------------------------------------
// 6. BOARD POST MODEL
// -------------------------------------------------
model BoardPost {
  id          String   @id @default(uuid())
  looking     String
  offering    String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  authorId    String

  author User @relation("UserBoardPosts", fields: [authorId], references: [id])
}

// -------------------------------------------------
// 7. SWAP MODEL (Updated with Bilateral Accountability)
// -------------------------------------------------
model Swap {
  schedule       SwapSession[]
  id             String        @id @default(uuid())
  status         SwapStatus
  requesterId    String
  receiverId     String
  offeredSkillId String
  wantedSkillId  String

  requestId           String?               @unique
  request             SwapRequest?          @relation(fields: [requestId], references: [id], onDelete: Restrict)
  integrityVerified   Boolean               @default(false)
  agreementVersion    Int                   @default(1)
  requesterApprovedAt DateTime?
  receiverApprovedAt  DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  sessionLogs         SessionConfirmation[]
  // Historical fixed hours. Null means each session has its own scheduled range.
  duration            Int?
  sessions            Int                   @default(4)

  // Bilateral Session Tracking
  requesterSessions Int @default(0)
  receiverSessions  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requester    User  @relation("RequestedSwaps", fields: [requesterId], references: [id])
  receiver     User  @relation("ReceivedSwaps", fields: [receiverId], references: [id])
  offeredSkill Skill @relation("ActiveOfferedSkill", fields: [offeredSkillId], references: [id])
  wantedSkill  Skill @relation("ActiveWantedSkill", fields: [wantedSkillId], references: [id])

  reviews  Review[]
  messages Message[] // Allows chat history to be tied to this swap
}

enum Role {
  USER
  ADMIN
}

model Post {
  id        String   @id @default(uuid())
  title     String
  content   String   @db.Text
  category  String   @default("GENERAL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String
  author   User      @relation("UserPosts", fields: [authorId], references: [id], onDelete: Cascade)
  comments Comment[]
}

model Comment {
  id        String   @id @default(uuid())
  content   String   @db.Text
  createdAt DateTime @default(now())

  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("UserComments", fields: [authorId], references: [id], onDelete: Cascade)
}

model SwapSession {
  id            String   @id @default(uuid())
  swapId        String
  sessionNumber Int
  scheduledAt   DateTime
  endsAt        DateTime?
  meetingLink   String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  swap          Swap     @relation(fields: [swapId], references: [id], onDelete: Restrict)

  @@unique([swapId, sessionNumber])
}

enum SwapRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum SwapStatus {
  PENDING_AGREEMENT
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Program {
  id                   String      @id @default(uuid())
  code                 String      @unique
  label                String      @unique
  isActive             Boolean     @default(true)
  departmentId         String?
  mappingValidatedAt   DateTime?
  mappingValidatedById String?
  mappingNotes         String?     @db.Text
  mappingVersion       Int         @default(0)
  department           Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  yearLevels           YearLevel[] @relation("ProgramYearLevels")
  students             User[]
}

model RegistrationConsent {
  id String @id @default(uuid())
  userId String
  noticeVersion String
  acceptedAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, noticeVersion])
}


// Administrator reply-moderation metadata only. Snapshot IDs intentionally have
// no cascading relations; no deleted content, email, IP address or tokens.
model AdminAudit {
  id              String   @id @default(uuid())
  administratorId String
  threadId        String?
  commentId       String?  @unique
  commentAuthorId String?
  reportId        String?
  evidenceId      String?
  action          String   @db.VarChar(32)
  reason          String?  @db.VarChar(32)
  explanation     String?  @db.VarChar(250)
  createdAt       DateTime @default(now())

  @@index([createdAt, id])
  @@index([threadId, createdAt])
  @@index([reportId, createdAt])
}

// PENDING rows survive interrupted uploads for guarded orphan cleanup.
// Only ATTACHED rows have a report; the report and attachment commit together.
model ReportEvidence {
  id          String      @id @default(uuid())
  reportId    String?     @unique
  report      UserReport? @relation(fields: [reportId], references: [id], onDelete: Restrict)
  objectKey   String      @unique @db.VarChar(191)
  state       String      @default("PENDING") @db.VarChar(32)
  mimeType    String      @db.VarChar(32)
  byteLength  Int
  width       Int
  height      Int
  sha256      String      @db.Char(64)
  createdAt   DateTime    @default(now())

  @@index([state, createdAt])
}
