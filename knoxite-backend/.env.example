PORT=5000
DATABASE_URL=mysql://knoxite:local-only@127.0.0.1:3307/knoxite_dev
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Required in production. Values must be approved by the institution.
INSTITUTION_EMAIL_DOMAINS=student.fatima.edu.ph
EMAIL_VERIFICATION_REQUIRED=true
PUBLIC_APP_URL=http://localhost:5173

# Provisional: the team must obtain official confirmation before production activation.
CAMPUS_EMAIL_SUFFIX=lag
CAMPUS_EMAIL_RULE_CONFIRMED=false
# Institutional mail service webhook; tokens are never logged or exposed by the API.
# The service must support both knoxite-email-verification (verificationLink)
# and knoxite-password-reset (resetLink) templates. No real email is sent until configured.
EMAIL_DELIVERY_URL=
EMAIL_DELIVERY_TOKEN=

# Google Identity Services / OpenID Connect. Keep disabled until documented approval.
# Public web-client ID; no client secret is required for this ID-token flow.
GOOGLE_SIGN_IN_ENABLED=false
GOOGLE_CLIENT_ID=
# Confirm actual signed hd domains with institutional IT; do not infer from email.
GOOGLE_ALLOWED_HOSTED_DOMAINS=
GOOGLE_WORKSPACE_ACCESS_CONFIRMED=false
GOOGLE_ELIGIBILITY_RULES_CONFIRMED=false
GOOGLE_SECURITY_REVIEW_CONFIRMED=false
GOOGLE_ELIGIBILITY_POLICY_VERSION=
