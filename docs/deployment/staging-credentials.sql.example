-- TEMPLATE ONLY. Not executable until reviewed/replaced by the owner.
-- Do not run on production or any existing protected local database.
-- knoxite-staging may be a Railway SERVICE name; inspect actual MYSQLDATABASE.
-- Run only through an independently authenticated staging-owner connection.
-- Use distinct strong passwords privately; never commit the completed template.
-- If an account already exists, STOP; do not silently overwrite/reuse it.

CREATE USER 'knoxite_staging_app'@'%'
  IDENTIFIED BY '<APP_PASSWORD_FROM_PRIVATE_OPERATOR_PROMPT>' REQUIRE SSL;
GRANT SELECT, INSERT, UPDATE, DELETE ON `<ACTUAL_STAGING_SCHEMA>`.*
  TO 'knoxite_staging_app'@'%';

CREATE USER 'knoxite_staging_migrator'@'%'
  IDENTIFIED BY '<DIFFERENT_PRIVATE_MIGRATION_PASSWORD>' REQUIRE SSL;
GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, ALTER, DROP, INDEX, REFERENCES
  ON `<ACTUAL_STAGING_SCHEMA>`.* TO 'knoxite_staging_migrator'@'%';

-- Scope host restrictions to Render's verified egress where supported; '%' does
-- not restrict client IPs. Neither user has global privileges or GRANT OPTION.
-- Never give the application the migrator/root MYSQL_PUBLIC_URL.
-- No DATABASE creation, migration, seeding, approval or account provisioning here.
-- After the separately authorized migration and checks, the owner should lock
-- the migrator when not needed. Unlocking/reuse needs a new reviewed window.
-- ALTER USER 'knoxite_staging_migrator'@'%' ACCOUNT LOCK;
