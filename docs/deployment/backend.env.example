# OFFLINE WORKSHEET ONLY. No domain is owned or sender verified yet.
# Do not load into an existing local environment or production service.
NODE_ENV=production
HOST=0.0.0.0
# Hosting provider supplies PORT. Keep secrets in its private secret store.
DATABASE_URL=
# mysql://<APP_USER>:<URL_ENCODED_PASSWORD>@<HOST>:<PORT>/<DB>?<PROVIDER_TLS_PARAMETERS>
JWT_SECRET=
PUBLIC_APP_URL=https://app.example.invalid
CORS_ORIGINS=https://app.example.invalid
INSTITUTION_EMAIL_DOMAINS=student.fatima.edu.ph
CAMPUS_EMAIL_SUFFIX=lag
EMAIL_VERIFICATION_REQUIRED=true
CAMPUS_EMAIL_RULE_CONFIRMED=false

# Required production policy; startup checks the additive session schema.
# Follow the reviewed fresh-install or exact-schema legacy upgrade path first.
# Do not turn this off to launch with seven-day sessions.
SESSION_TIMEOUTS_ENABLED=true

# Intentionally unapproved placeholders: configure only after notice/retention review.
REGISTRATION_CONSENT_ENABLED=false
REGISTRATION_NOTICE_VERSION=
REGISTRATION_NOTICE_APPROVED=false

# No live sending: blank key and unapproved sender intentionally fail closed.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=notifications@sender.example.invalid
EMAIL_SENDER_APPROVED=false
EMAIL_DELIVERY_URL=
EMAIL_DELIVERY_TOKEN=

# Public client ID belongs only in backend config; frontend obtains it from providers API.
# No client secret is used in the existing GIS ID-token callback flow.
GOOGLE_SIGN_IN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_HOSTED_DOMAINS=
GOOGLE_WORKSPACE_ACCESS_CONFIRMED=false
GOOGLE_ELIGIBILITY_RULES_CONFIRMED=false
GOOGLE_SECURITY_REVIEW_CONFIRMED=false
GOOGLE_ELIGIBILITY_POLICY_VERSION=

# NEVER copy KNOXITE_LOCAL_*, GOOGLE_LOCAL_PILOT_* or synthetic sandbox variables here.
# Enrollment decision, reviewed schema/restore, operator approval and actual domain
# are still required; this is not an executable or approved release configuration.
